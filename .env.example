DJANGO_SETTINGS_MODULE=config.settings.local
# Replace this with a unique random value before any shared/deployed use.
DJANGO_SECRET_KEY=local-example-replace-this-with-a-unique-random-secret-key-1234567890
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3

# Docker Compose local database credentials only. Replace before shared use.
POSTGRES_PASSWORD=docker-development-only

# Optional production database example:
# DATABASE_URL=postgresql://fuel:fuel@db:5432/fuel

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=fuel-route-assessment/1.0 (replace-with-maintainer-contact)
GEOCODER_TIMEOUT_SECONDS=10
GEOCODER_MIN_INTERVAL_SECONDS=1

OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
ROUTING_CONNECT_TIMEOUT_SECONDS=3
ROUTING_READ_TIMEOUT_SECONDS=10
ROUTE_CACHE_TTL_SECONDS=86400

# Production should use a shared cache backend when multiple web workers run.
# The default local cache is intentionally dependency-free for the assessment.
